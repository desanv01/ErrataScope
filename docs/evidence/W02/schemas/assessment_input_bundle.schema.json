    "FactVersion": {
      "additionalProperties": false,
      "properties": {
        "evidence_refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "declared",
            "extracted",
            "measured",
            "external"
          ],
          "title": "Origin",
          "type": "string"
        },
        "predecessor_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Predecessor Id"
        },
        "review_state": {
          "enum": [
            "draft",
            "accepted",
            "rejected"
          ],
          "title": "Review State",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/EvaluationScope"
        },
        "selector": {
          "minLength": 1,
          "title": "Selector",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "boolean": "#/$defs/BooleanValue",
                  "integer": "#/$defs/IntegerValue",
                  "quantity": "#/$defs/QuantityValue",
                  "text": "#/$defs/TextValue"
                },
                "propertyName": "kind"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/TextValue"
                },
                {
                  "$ref": "#/$defs/BooleanValue"
                },
                {
                  "$ref": "#/$defs/IntegerValue"
                },
                {
                  "$ref": "#/$defs/QuantityValue"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "id",
        "scope",
        "selector",
        "value",
        "origin",
        "review_state"
      ],
      "title": "FactVersion",
      "type": "object"
    },
