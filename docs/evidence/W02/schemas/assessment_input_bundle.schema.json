        },
        "reviewed": {
          "items": {
            "$ref": "#/$defs/EntryKey"
          },
          "title": "Reviewed",
          "type": "array"
        },
        "selected": {
          "items": {
            "$ref": "#/$defs/EntryKey"
          },
          "title": "Selected",
          "type": "array"
        },
        "supported": {
          "items": {
            "$ref": "#/$defs/EntryKey"
          },
          "title": "Supported",
          "type": "array"
        },
        "unsupported": {
          "items": {
            "$ref": "#/$defs/EntryKey"
          },
          "title": "Unsupported",
          "type": "array"
        }
