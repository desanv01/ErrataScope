    "All": {
      "additionalProperties": false,
      "properties": {
        "children": {
          "items": {
            "discriminator": {
              "mapping": {
                "all": "#/$defs/All",
                "any": "#/$defs/Any",
                "constant": "#/$defs/Constant",
                "eq": "#/$defs/Eq",
                "gt": "#/$defs/Gt",
                "gte": "#/$defs/Gte",
                "in": "#/$defs/In",
                "lt": "#/$defs/Lt",
                "lte": "#/$defs/Lte",
                "not": "#/$defs/Not"
              },
              "propertyName": "op"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/Eq"
              },
              {
                "$ref": "#/$defs/In"
              },
              {
                "$ref": "#/$defs/Lt"
              },
              {
                "$ref": "#/$defs/Lte"
              },
              {
                "$ref": "#/$defs/Gt"
              },
              {
                "$ref": "#/$defs/Gte"
              },
              {
                "$ref": "#/$defs/All"
              },
              {
                "$ref": "#/$defs/Any"
              },
              {
                "$ref": "#/$defs/Not"
              },
              {
                "$ref": "#/$defs/Constant"
              }
            ]
          },
          "title": "Children",
          "type": "array"
        },
        "op": {
          "const": "all",
          "default": "all",
          "title": "Op",
          "type": "string"
        }
      },
      "required": [
        "children"
      ],
      "title": "All",
      "type": "object"
    },
    "Any": {
      "additionalProperties": false,
      "properties": {
        "children": {
          "items": {
            "discriminator": {
              "mapping": {
                "all": "#/$defs/All",
                "any": "#/$defs/Any",
                "constant": "#/$defs/Constant",
                "eq": "#/$defs/Eq",
                "gt": "#/$defs/Gt",
                "gte": "#/$defs/Gte",
                "in": "#/$defs/In",
                "lt": "#/$defs/Lt",
                "lte": "#/$defs/Lte",
                "not": "#/$defs/Not"
              },
              "propertyName": "op"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/Eq"
              },
              {
                "$ref": "#/$defs/In"
              },
              {
                "$ref": "#/$defs/Lt"
              },
              {
                "$ref": "#/$defs/Lte"
              },
              {
                "$ref": "#/$defs/Gt"
              },
              {
                "$ref": "#/$defs/Gte"
              },
              {
                "$ref": "#/$defs/All"
              },
              {
                "$ref": "#/$defs/Any"
              },
              {
                "$ref": "#/$defs/Not"
              },
              {
                "$ref": "#/$defs/Constant"
              }
            ]
          },
          "title": "Children",
          "type": "array"
        },
        "op": {
          "const": "any",
          "default": "any",
          "title": "Op",
          "type": "string"
        }
      },
      "required": [
        "children"
      ],
      "title": "Any",
      "type": "object"
    },
    "BooleanValue": {
      "additionalProperties": false,
      "properties": {
