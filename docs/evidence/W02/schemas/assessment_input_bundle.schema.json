          "default": null,
          "title": "Source Url"
        },
        "synthetic": {
          "title": "Synthetic",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "project_id",
        "document_sha256",
        "authority",
        "synthetic"
      ],
      "title": "DocumentVersion",
      "type": "object"
    },
    "EntryKey": {
      "additionalProperties": false,
      "properties": {
        "document_version_id": {
          "format": "uuid",
