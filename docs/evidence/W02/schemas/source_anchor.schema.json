{
  "additionalProperties": false,
  "properties": {
    "anchor_id": {
      "minLength": 1,
      "title": "Anchor Id",
      "type": "string"
    },
    "bbox": {
      "anyOf": [
        {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Bbox"
    },
    "document_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Document Sha256",
      "type": "string"
    },
    "document_version_id": {
      "format": "uuid",
      "title": "Document Version Id",
      "type": "string"
    },
    "geometry_kind": {
      "enum": [
        "located",
        "synthetic_not_located"
      ],
      "title": "Geometry Kind",
      "type": "string"
    },
    "page_height_pt": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Page Height Pt"
    },
    "page_index": {
      "minimum": 0,
      "title": "Page Index",
      "type": "integer"
    },
    "page_rotation": {
      "maximum": 359,
      "minimum": 0,
      "title": "Page Rotation",
      "type": "integer"
    },
    "page_width_pt": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Page Width Pt"
    },
    "parser_name": {
      "minLength": 1,
      "title": "Parser Name",
      "type": "string"
    },
    "parser_version": {
      "minLength": 1,
      "title": "Parser Version",
      "type": "string"
    },
    "printed_page_label": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Printed Page Label"
    },
    "section": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Section"
    },
    "text": {
      "minLength": 1,
      "title": "Text",
      "type": "string"
    }
  },
  "required": [
    "anchor_id",
    "document_version_id",
    "document_sha256",
    "page_index",
    "text",
    "page_rotation",
    "parser_name",
    "parser_version",
    "geometry_kind"
  ],
  "title": "SourceAnchor",
  "type": "object"
}
