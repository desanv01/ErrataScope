{
  "$defs": {
    "ComponentIdentity": {
      "additionalProperties": false,
      "properties": {
        "evidence_refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "exact_part": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Exact Part"
        },
        "family": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Family"
        },
        "manufacturer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Manufacturer"
        },
        "package": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Package"
        },
        "silicon_revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Silicon Revision"
        }
      },
      "required": [
        "manufacturer",
        "exact_part",
        "family",
        "package",
        "silicon_revision"
      ],
      "title": "ComponentIdentity",
      "type": "object"
    },
    "ComponentInstance": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "identity": {
          "$ref": "#/$defs/ComponentIdentity"
        },
        "project_id": {
          "format": "uuid",
          "title": "Project Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "project_id",
        "identity"
      ],
      "title": "ComponentInstance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "board_revision": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Board Revision"
    },
    "component_instances": {
      "items": {
        "$ref": "#/$defs/ComponentInstance"
      },
      "minItems": 1,
      "title": "Component Instances",
      "type": "array"
    },
    "content_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Hash",
      "type": "string"
    },
    "firmware_build_id": {
      "format": "uuid",
      "title": "Firmware Build Id",
      "type": "string"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "operating_profile_id": {
      "format": "uuid",
      "title": "Operating Profile Id",
      "type": "string"
    },
    "predecessor_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Predecessor Id"
    },
    "product_name": {
      "minLength": 1,
      "title": "Product Name",
      "type": "string"
    },
    "project_id": {
      "format": "uuid",
      "title": "Project Id",
      "type": "string"
    }
  },
  "required": [
    "id",
    "project_id",
    "product_name",
    "firmware_build_id",
    "operating_profile_id",
    "component_instances",
    "content_hash"
  ],
  "title": "ProductSnapshot",
  "type": "object"
}
